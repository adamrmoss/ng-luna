{
    "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
    "dest": "./dist",
    "assets": [
        {
            "input": "./",
            "glob": "THIRD-PARTY-LICENSES.md",
            "output": "/"
        },
        {
            "input": "./node_modules/@ibm/plex",
            "glob": "IBM-Plex-*/fonts/complete/woff2/**/*",
            "output": "/assets/fonts"
        },
        {
            "input": "./node_modules/@ibm/plex",
            "glob": "IBM-Plex-*/fonts/complete/woff/**/*",
            "output": "/assets/fonts"
        },
        {
            "input": "./src/theme",
            "glob": "_*.scss",
            "output": "/theme"
        }
    ],
    "lib": {
        "entryFile": "src/public-api.ts",
        "cssUrl": "none",
        "styleIncludePaths": [
            "src/theme",
            "node_modules"
        ]
    },
    "allowedNonPeerDependencies": [
        "@angular/cdk",
        "@ibm/plex",
        "lucide-static"
    ]
}
