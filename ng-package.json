{
    "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
    "dest": "./dist",
    "assets": [
        {
            "input": "./node_modules/@ibm/plex",
            "glob": "IBM-Plex-Mono/**/*",
            "output": "/assets/fonts"
        },
        {
            "input": "./node_modules/@ibm/plex",
            "glob": "IBM-Plex-Sans/**/*",
            "output": "/assets/fonts"
        },
        {
            "input": "./node_modules/@ibm/plex",
            "glob": "IBM-Plex-Serif/**/*",
            "output": "/assets/fonts"
        }
    ],
    "lib": {
        "entryFile": "src/public-api.ts",
        "cssUrl": "none",
        "styleIncludePaths": [
            "src/theme",
            "node_modules"
        ]
    },
    "allowedNonPeerDependencies": [
        "@angular/cdk",
        "@ibm/plex"
    ]
}
