{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "declaration": true,
        "declarationMap": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strict": true,
        "skipLibCheck": true,
        "inlineSources": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist/out-tsc",
        "types": [],
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "angularCompilerOptions": {
        "enableIvy": true,
        "strictTemplates": true
    },
    "exclude": [
        "dist",
        "node_modules",
        "**/*.spec.ts"
    ]
}
