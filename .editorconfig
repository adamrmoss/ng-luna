# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = auto
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = off
trim_trailing_whitespace = true

# TypeScript and JavaScript
[*.{ts,js}]
quote_type = single
ij_javascript_class_brace_style = next_line
ij_javascript_enforce_trailing_comma = multiline
ij_javascript_for_brace_style = next_line
ij_javascript_force_semicolon_style = true
ij_javascript_if_brace_style = next_line
ij_javascript_import_sort_module_name = true
ij_javascript_imports_wrap = on_every_item
ij_javascript_method_brace_style = next_line
ij_javascript_space_after_type_colon = true
ij_javascript_space_before_for_parentheses = true
ij_javascript_space_before_if_parentheses = true
ij_javascript_space_before_while_parentheses = true
ij_javascript_spaces_around_additive_operators = true
ij_javascript_spaces_around_assignment_operators = true
ij_javascript_spaces_around_equality_operators = true
ij_javascript_spaces_around_multiplicative_operators = true
ij_javascript_spaces_around_relational_operators = true
ij_javascript_spaces_before_method_parentheses = false
ij_javascript_spaces_within_array_initializer_brackets = true
ij_javascript_spaces_within_imports = true
ij_javascript_spaces_within_method_call_parentheses = false
ij_javascript_spaces_within_method_parentheses = false
ij_javascript_spaces_within_object_literal_braces = true
ij_javascript_use_double_quotes = false
ij_javascript_use_single_quotes = true
ij_javascript_while_brace_style = next_line
ij_typescript_class_brace_style = next_line
ij_typescript_enforce_trailing_comma = multiline
ij_typescript_for_brace_style = next_line
ij_typescript_force_semicolon_style = true
ij_typescript_if_brace_style = next_line
ij_typescript_import_sort_module_name = true
ij_typescript_imports_wrap = on_every_item
ij_typescript_method_brace_style = next_line
ij_typescript_space_after_type_colon = true
ij_typescript_space_before_for_parentheses = true
ij_typescript_space_before_if_parentheses = true
ij_typescript_space_before_while_parentheses = true
ij_typescript_spaces_around_additive_operators = true
ij_typescript_spaces_around_assignment_operators = true
ij_typescript_spaces_around_equality_operators = true
ij_typescript_spaces_around_multiplicative_operators = true
ij_typescript_spaces_around_relational_operators = true
ij_typescript_spaces_before_method_parentheses = false
ij_typescript_spaces_within_array_initializer_brackets = true
ij_typescript_spaces_within_imports = true
ij_typescript_spaces_within_method_call_parentheses = false
ij_typescript_spaces_within_method_parentheses = false
ij_typescript_spaces_within_object_literal_braces = true
ij_typescript_use_double_quotes = false
ij_typescript_use_explicit_js_extension = never
ij_typescript_use_single_quotes = true
ij_typescript_while_brace_style = next_line

# HTML Templates
[*.html]
quote_type = double
ij_html_quote_style = double
ij_html_space_inside_empty_tag = true
ij_html_spaces_inside_attribute_brackets = false

# SCSS and CSS
[*.{scss,css}]
quote_type = single
ij_css_brace_placement = next_line
ij_css_enforce_quotes_on_format = true
ij_css_hex_color_long_format = false
ij_css_hex_color_lowercase = true
ij_css_keep_blank_lines_in_code = 1
ij_css_prefer_hex_color = true
ij_css_use_double_quotes = false
ij_scss_brace_placement = next_line
ij_scss_enforce_quotes_on_format = true
ij_scss_hex_color_long_format = false
ij_scss_hex_color_lowercase = true
ij_scss_keep_blank_lines_in_code = 1
ij_scss_prefer_hex_color = true
ij_scss_use_double_quotes = false

# JSON
[*.json]
quote_type = double
ij_json_trailing_comma_on_array = false
ij_json_trailing_comma_on_object = false
ij_json_use_double_quotes = true

# Markdown
[*.md]
trim_trailing_whitespace = false
